<h2>Daftar 8 Poin DPL</h2>
<table>
<tr><th>No</th><th>DPL</th><th>Deskripsi</th></tr>
<tr><td>1</td><td>DPL 1</td><td>Keimanan dan ketakwaan kepada Tuhan Yang Maha Esa</td></tr>
<tr><td>2</td><td>DPL 2</td><td>Kewargaan *(bukan Kewarganegaraan)*</td></tr>
<tr><td>3</td><td>DPL 3</td><td>Penalaran kritis</td></tr>
<tr><td>4</td><td>DPL 4</td><td>Kreativitas</td></tr>
<tr><td>5</td><td>DPL 5</td><td>Kolaborasi</td></tr>
<tr><td>6</td><td>DPL 6</td><td>Kemandirian</td></tr>
<tr><td>7</td><td>DPL 7</td><td>Kesehatan</td></tr>
<tr><td>8</td><td>DPL 8</td><td>Komunikasi</td></tr>
</table>

<h2>Daftar Kolom Komponen RPM</h2>
